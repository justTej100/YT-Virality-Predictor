# Copy this to .env in the repo root. One file, used by both services.
# Never commit the real .env — it's already in .gitignore.

# Required: free key from Google Cloud Console -> enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# Used by the frontend to know where the backend is
VITE_API_BASE_URL=http://localhost:8000

# Optional, set automatically by the GitHub Actions deploy workflow
DEPLOY_TIME=
GIT_COMMIT_SHA=
